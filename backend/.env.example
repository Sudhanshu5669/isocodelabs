# Copy this file to .env and fill in real values. Never commit .env.
PORT=8080
# development on your own machine; unset means production (secure cookies)
APP_ENV=development
# Supabase Postgres. Copy both from the dashboard: Connect > Connection string.
# Session pooler, port 5432 (migrations, seeding, tests):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Transaction pooler, port 6543 (the running app):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_POOLED=
# Behind a hosting proxy: the ONE header it sets to the client IP (e.g. Fly-Client-IP). Empty = no proxy.
TRUSTED_PROXY_HEADER=
# Extra browser origins allowed to send POST requests (comma separated).
# Defaults to http://localhost:5173 in development and to nothing in production.
ALLOWED_ORIGINS=
# Optional: serve the built React app from this folder (e.g. ../frontend/dist). Empty = API only.
STATIC_DIR=
# Optional: public site address; reminder messages link to PUBLIC_URL/visit/<code>
PUBLIC_URL=
# Optional: secret the messaging provider sends with buyer replies ("STOP"). Empty = endpoint off.
INBOUND_WEBHOOK_SECRET=
# Set to off to stop the background reminder sender on this server.
REMINDERS=
# The AI behind the chat. AI_PROVIDER alone picks the company: gemini (default), openai or offline.
# AI_MODEL picks the model; empty = that provider's default (gemini-3.5-flash-lite / gpt-6-luna).
# Without the chosen provider's key the chat runs on fixed replies and hands every buyer to a person.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible API instead of OpenAI itself (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional: OpenAI reasoning_effort. Empty = none (needed by gpt-6-luna to use tools; fast and cheap).
# Older gpt-5 / gpt-5-mini / gpt-5-nano need "minimal"; "off" leaves it out for models without reasoning (gpt-4.1-mini).
OPENAI_REASONING_EFFORT=
# REQUIRED. Personal data (names, phones, emails, chat text) is encrypted with AES-256-GCM
# before it reaches the database (DPDP Act). Generate each value with: openssl rand -base64 32
# PII_ENCRYPTION_KEYS lists "id:key"; to rotate, add a new one ("1:<old>,2:<new>"): new data uses the
# highest id and old data still decrypts. PII_INDEX_KEY is the separate HMAC-SHA-256 key for the
# blind indexes (login by email, dedupe and search by phone and name) and must differ from them.
# Back both up: without them the data cannot be decrypted.
PII_ENCRYPTION_KEYS=1:
PII_INDEX_KEY=
