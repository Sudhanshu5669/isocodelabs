# Copy this file to .env and fill in real values. Never commit .env.
PORT=8080
APP_ENV=development
# Neon direct connection (migrations, seeding)
DATABASE_URL=
# Neon pooled connection (the running app)
DATABASE_URL_POOLED=
# Extra browser origins allowed to send POST requests (comma separated).
# Defaults to http://localhost:5173 in development and to nothing in production.
ALLOWED_ORIGINS=
# Google Gemini API key
GEMINI_API_KEY=
